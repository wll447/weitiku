<?xml version="1.0" encoding="utf-8"?>
<!-- 导入引导，照同类产品 activity_import_guide.xml 的结构（标题 30dp + 说明 + 示例块），
     示例原本是 150dp 截图，这里换成本项目的文字示例块（格式说明按魏题库真实导入规则写） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <RelativeLayout
        style="@style/WeiTiku.Toolbar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/WeiTiku.Toolbar.Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="题库导入方法"
            android:textColor="@color/text_main"
            android:textSize="18sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:text="支持的格式"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Excel 题库：.xlsx 和 .xls 都支持，多个工作表会自动合并。\n文本题库：.csv 和 .txt，逗号分隔（第一行写列名）。"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:text="Excel 列怎么摆（按列名自动识别，顺序随意）"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="第一行是表头，识别下面这些列名：\n\n· 题干：题干 / 题目 / 题目标题 / 问题\n· 答案：答案 / 正确答案（写 A、B、C、D，多选写 ABC）\n· 选项：选项A～选项G，或 选项1～选项7，也认 A、B、C… 这种列名\n· 解析（可选）：解析 / 题目解析 / 答案解析\n· 题型（可选）：题型 / 类型\n\n其余列（序号、章节、备注等）会被自动忽略。"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <!-- 示例块（替代原版截图） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_bg_rectangle_white"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="题目标题 | 答案 | 题目解析 | 选项A | 选项B | 选项C | 选项D\n按照《技规》第（）条要求… | D | 单项选择 | 20 | 21 | 22 | 25\n冬季在杆顶作业时… | A | 判断题 | 正确 | 错误 |  | \n\n↑ 这种文件可以直接导入。以前的同类产品会\n把「题目解析」当成选项A（整体错位），\n魏题库按列名识别，不会串位。"
                android:textColor="@color/text_main"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:text="没有表头怎么办"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="识别不到表头时，按固定列位读：\n第1列=题干，第2列=答案，第3列起依次是 A、B、C、D…"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:text="文本题库（.csv / .txt）"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="每行一道题，逗号分隔，第一行建议写列名：\n\n题干,答案,选项A,选项B,选项C,选项D\n中国的首都是哪里,A,北京,上海,广州,深圳"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:text="怎么把文件弄进手机"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="1. 用微信/QQ 把 Excel 文件发到手机（发给自己即可）\n2. 在手机上点开这个文件，选择「用其他应用打开」\n3. 选「魏题库」，就会自动导入并显示成功题数\n\n也可以：把文件放到手机存储里，在首页点「导入题库」自己选文件。"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="导入失败常见原因：\n· 第一行没有列名，且列位不是「题干|答案|选项…」的顺序\n· 答案列是空的（每道题必须有答案）\n· 题干为空或整行只有序号"
                android:textColor="#FFE04B4B"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
