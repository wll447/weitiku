<?xml version="1.0" encoding="utf-8"?>
<!-- 拍照搜题，照同类产品 activity_photo_camera.xml（全屏相机 + 返回/闪光 + 底部栏：历史/快门/相册） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 实时取题框：取景时自动套住题目（对齐豆包的取题框） -->
    <com.weizh.tiku.ui.scan.BoxOverlayView
        android:id="@+id/boxOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 相机没起来时的引导（原来只有黑背景+Toast，页面上什么都不提示） -->
    <LinearLayout
        android:id="@+id/ll_camera_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_camera_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text="相机没启动起来"
            android:textColor="#FFDDDDDD"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_pick_album2"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill_green"
            android:gravity="center"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="从相册选图"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ic_btn_back_bg"
        android:padding="6dp"
        android:src="@drawable/ic_back_white" />

    <ImageView
        android:id="@+id/btn_flash"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentRight="true"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/ic_btn_back_bg"
        android:padding="7dp"
        android:src="@drawable/ic_flash_off" />

    <TextView
        android:id="@+id/tv_photo_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_photo_points_chip"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="把题目放进取景框"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/container_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_photo_album" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="相册"
                android:textColor="#FFCCCCCC"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_shutter"
            android:layout_width="0dp"
            android:layout_height="86dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/btn_shutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shutter" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/container_scan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_kong_scan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="扫描搜题"
                android:textColor="#FFCCCCCC"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
