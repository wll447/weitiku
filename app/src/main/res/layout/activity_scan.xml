<?xml version="1.0" encoding="utf-8"?>
<!-- 结构照同类产品 activity_camera.xml：相机全屏做背景，垂直分栏 —— 上半扫描区 / 下半结果列表，物理不重叠 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black33"
    android:fitsSystemWindows="true">

    <!-- 相机全屏：作为整屏背景（同类产品用 CameraView，这里用 CameraX PreviewView） -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="20dp"
            android:background="@drawable/bg_pill"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_revert" />

        <!-- 扫描区（对应同类产品 ResizableScanView，占上半部分） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.weizh.tiku.ui.widget.view.ResizableScanView
                android:id="@+id/scan_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.weizh.tiku.ui.scan.BoxOverlayView
                android:id="@+id/boxOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 提示：照同类产品 scan_hint_vip 的文案（我们去掉了"会员专享"，因为全部免费） -->
        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="缩放：捏合手势/拖动边缘 | 移动：拖动中心"
            android:textColor="#FFD9A441"
            android:textSize="12sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvLock"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_bg_lock"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="锁定结果"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvReset"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/tvLock"
                android:background="@drawable/btn_bg_reset_dim"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="重置识别区域"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- 结果列表（对应同类产品 RecyclerView list，占下半部分、背景透明，卡片半透明黑） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHits"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <!-- 识别原文（同类产品："会显示原题，提高准确率"） -->
        <TextView
            android:id="@+id/tvOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:maxLines="2"
            android:padding="8dp"
            android:text="对准题目后自动识别…"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</RelativeLayout>
