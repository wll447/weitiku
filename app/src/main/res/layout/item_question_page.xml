<?xml version="1.0" encoding="utf-8"?>
<!-- 题目页（ViewPager 的一页），照同类产品 item_question_page.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.weizh.tiku.ui.widget.view.ExerciseView
            android:id="@+id/exerciseview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_ahead_question"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="下一题"
                android:textColor="@color/brand_primary"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- 解析区（同类产品是云端 AI 解析；本地版先显示占位，后续接 ai3080） -->
        <LinearLayout
            android:id="@+id/ll_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:text="题目解析"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_explain_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/btn_bg_float_gray2"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="本地题库暂无解析"
                    android:textColor="@color/text_sub"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_explain_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="12dp"
                android:lineSpacingExtra="4dp"
                android:text="这道题来自你导入的题库，题库文件里没有解析内容。"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
